[node name="DialogueUi" parent="." instance=ExtResource("14_o7wln")]
defaultDialogueLines = PackedStringArray("Bienvenido a su aldea, aqui podras mejorar tus estadisticas y descasnsar despues de las arduas batallas.", "Cada edificio que ves es funcional, Ayuntamiento,Aserradero, Mina,Cantera, Barrio y Herreria.", "Cada una hace una cosa distinta.", "El Ayuntamiento produce oro, el Aserradero madera, la Cantera piedra y la Mina metal.", "Aunque tambien esta el barrio y la herreria, pero de esta ultima hablaremos mas tarde.", "El Barrio puede mejorar la vida todal de tu base, algo muy util cuando uno de esos malditos duendes consigue llegar a tu base.", "Todos los edificios se pueden mejorar para augmentar su produccion, pero es caro no siempre podras mejorarlo.", "Ves que ariba a la izquierda aparecen tus recursos, esos son los recursos sobrantes de tus partidas anteriores.", "Cada vez que completes un nivel todos los recursos sobrantes se sumaran al total de tu aldea.", "La puerta de la aldea te lleva al Mapamundi, donde estan todos los niveles.", "Pero primero...", "Que tal si te das una vuelta por la aldea, quien sabe alomejor haces amiguitas.")
